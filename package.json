{
  "name": "powerflame-website",
  "version": "1.0.0",
  "private": true,
  "description": "Marketing website for Powerflame Energy (Private) Limited, LPG supplier in Hatfield, Harare.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:colors": "node scripts/check-colors.mjs",
    "brand": "node scripts/generate-brand-assets.mjs",
    "verify": "npm run check:colors && npm run typecheck && npm run lint && npm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "framer-motion": "^14.14.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  }
}
